{
    "name": "c3r-workspace",
    "private": true,
    "workspaces": [
        "packages/*",
        "examples"
    ],
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "dev": "npm run dev -w c3r-examples",
        "typecheck": "tsc -b",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    }
}
